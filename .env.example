# .env.example — AI 城市漫游产品 环境变量模板
# 用法：cp .env.example .env 后填入真实值。真实 .env 严禁提交（见 .gitignore）。
# 对应：config.go / ai-integration-rules.md / deployment-architecture.md

# ---------- 数据库 ----------
DB_HOST=mysql
DB_PORT=3306
DB_USER=city_roam
DB_PASSWORD=change_me_strong_password
DB_NAME=city_roam
# GORM 连接池（与 MySQL max_connections=50 协调）
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5

# ---------- 服务 ----------
SERVER_PORT=8080
# 静态与上传目录（容器内路径，对应 compose 卷挂载）
STATIC_DIR=/app/static
UPLOAD_DIR=/app/uploads
# 城市与成就 seed JSON 目录
SEED_DIR=/app/data/seed
# 上传限制
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,webp

# ---------- AI：对话 LLM（仅后端可见） ----------
LLM_API_BASE=https://api.your-llm-provider.com/v1
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=gpt-4o-mini

# ---------- AI：图像生成（仅后端可见） ----------
IMAGE_API_BASE=https://api.your-image-provider.com/v1
IMAGE_API_KEY=sk-REPLACE_ME

# AI 统一超时（秒）
AI_TIMEOUT_SECONDS=30

# ---------- CORS ----------
# 多个用逗号分隔；MVP 可填前端访问地址
CORS_ALLOW_ORIGINS=http://localhost,http://localhost:5173

# ---------- 前端（VITE_ 前缀，构建时注入；属公开 Key） ----------
# 注意：高德 JS Key 为前端公开 Key，可放此处；LLM/IMAGE Key 绝不可加 VITE_ 前缀
VITE_AMAP_KEY=your_amap_js_key
VITE_AMAP_SECURITY_CODE=your_amap_security_code
VITE_API_BASE=/api

# ---------- 日志 ----------
LOG_LEVEL=info
